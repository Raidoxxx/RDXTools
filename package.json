{
  "name": "rdxcompressor",
  "version": "1.0.0",
  "description": "Conversor, compressor e redimensionador privado de imagens",
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --outDir build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs build",
    "build:discloud": "npm run build",
    "preview": "vite preview --host 127.0.0.1 --outDir build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "private": true,
  "type": "module"
}
